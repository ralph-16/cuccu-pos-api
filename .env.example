# Supabase project URL — found in Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase PUBLISHABLE key (new key system, replaces legacy "anon" key).
# Safe to use here because RLS policies enforce real access control per-user.
# NEVER put the SECRET key (replaces legacy "service_role") in this app.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# JWKS endpoint used to verify user access tokens locally (no round-trip
# to Supabase needed on every request). Found in Project Settings > API,
# or constructed as: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Port the Express server listens on locally (Render/most hosts override this automatically)
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
# e.g. http://127.0.0.1:5500,https://your-frontend-domain.com
ALLOWED_ORIGINS=http://127.0.0.1:5500

# --- PayMongo (GCash / Maya payment integration) ---

# Secret Test Key from PayMongo Dashboard > Developers. Server-side only,
# never expose to any client-facing code. Starts with sk_test_ in test mode,
# sk_live_ in production.
PAYMONGO_SECRET_KEY=sk_test_your_key_here

# Webhook signing secret, generated when you register a webhook endpoint
# in the PayMongo Dashboard (Developers > Webhooks). Used to verify that
# incoming webhook requests genuinely came from PayMongo.
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret_here